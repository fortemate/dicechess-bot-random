{
  "name": "dicechess-bot-random",
  "version": "1.0.0",
  "description": "Reference random-walk Dice Chess bot in TypeScript (Azure Functions & Node.js HTTP server).",
  "type": "module",
  "main": "dist/functions/*.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortemate/dicechess-bot-random.git"
  },
  "homepage": "https://fortemate.com",
  "bugs": {
    "url": "https://github.com/fortemate/dicechess-bot-random/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/bot.ts",
    "webhook": "tsx src/webhook-server.ts",
    "claim-identity": "tsx src/claim-identity.ts",
    "register": "tsx src/register.ts",
    "ladder:join": "tsx src/join-ladder.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/webhook.test.ts src/strategy.test.ts",
    "func:start": "func start"
  },
  "keywords": [
    "dicechess",
    "chess",
    "bot",
    "typescript",
    "starter-template",
    "azure-functions"
  ],
  "author": "Jegors Čemisovs",
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
